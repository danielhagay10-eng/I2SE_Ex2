# Google OAuth Client ID (מתוך Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gemini AI API Key (מתוך Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key

# הגדרות שליחת מיילים (Gmail SMTP + App Password בן 16 תווים באנגלית)
SMTP_HOST=smtp.gmail.com
SMTP_EMAIL=your-system-email@gmail.com
SMTP_PASSWORD=your16charapppass

# פרטי התחברות מנהל מערכת (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeStrongPassword2026

# מצב דמו סגור לבדיקות
ENABLE_DEMO_LOGIN=true
DEMO_LECTURER_EMAIL=demo.lecturer@smartlms.local
DEMO_STUDENT_EMAIL=demo.student@smartlms.local